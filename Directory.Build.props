<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Basic FTP Server Service</Product>
    <Company>Basic FTP Server Service</Company>
    <Copyright>Copyright (c) 2026</Copyright>

    <!--
      Single source of truth for the version. The installer reads it back out of the built
      executable rather than declaring its own, so the two cannot drift apart.
      IncludeSourceRevisionInInformationalVersion is off because the SDK otherwise appends
      "+<commit hash>" to ProductVersion, which would land in the installer's filename.
    -->
    <Version>1.1.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
