<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BasicFtpServer.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          The tray writes config under %ProgramData% and starts/stops the service, so it
          needs a full administrator token. A filtered token would be missing the
          Administrators SID and would be rejected by the control pipe's ACL.

          The installer registers the tray as a scheduled task set to run with highest
          privileges at logon, so this does not produce a UAC prompt every time you sign in.
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        DPI awareness is set via the ApplicationHighDpiMode project property instead, which
        is what WinForms expects. Long-path awareness matters here because scanner job names
        nested under a dated folder structure can exceed the legacy 260-character limit.
      -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
